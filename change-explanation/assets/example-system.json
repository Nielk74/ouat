      "status": "changed",
      "description": "Publish a durable job with a stable ID before returning its queued handle.",
      "code": {
        "file": "src/api/exports.ts",
        "symbol": "enqueueExport()",
        "language": "typescript",
        "before": "await buildExport(accountId);\nreturn { status: \"done\" };",
        "after": "const job = { id: jobId, accountId };\nawait exportQueue.publish(job);\nreturn { status: \"queued\", jobId };"
      },
