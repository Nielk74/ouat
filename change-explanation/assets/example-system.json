          "group": "api-runtime",
          "status": "unchanged",
          "meta": "await buildExport()",
          "issue": "The request waits for the export to finish."
        },
        {
          "id": "export",
          "label": "Build export",
          "kind": "function",
          "group": "api-runtime",
          "status": "unchanged",
          "meta": "inline execution"
        },
        {
          "id": "db",
          "label": "Results database",
          "kind": "database",
          "brand": "postgresql",
