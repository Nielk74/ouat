  "manualChanges": [
    {
      "change": "publish",
      "action": "Provision exports.ready with durable delivery and producer/consumer access.",
      "verification": "A published test job survives a consumer restart."
    },
    {
      "change": "deploy",
      "action": "Confirm callers accept queued handles and configure the worker binding.",
      "prerequisite": "Confirm queue access and unique job IDs.",
      "verification": "The consumer starts, completes a job, and persists its result before acknowledging."
    }
  ],
  "impact": [
    {
      "change": "publish",
      "basis": "expected",
      "description": "Callers need the job ID to retrieve eventual results."
    }
  ],
  "risks": [
    {
      "change": "pool",
      "title": "A job can be delivered more than once",
      "severity": "important",
      "condition": "A consumer stops after saving but before acknowledging.",
      "consequence": "Redelivery can repeat work and side effects.",
      "mitigation": "Preserve job IDs, upsert results, and make other effects idempotent."
    },
    {
      "change": "deploy",
      "title": "Jobs accumulate without a healthy consumer",
      "severity": "important",
      "condition": "The worker is stopped or its queue binding is wrong.",
      "consequence": "Accepted jobs wait for completion.",
      "mitigation": "Verify consumption after deployment; monitor queue age and worker health."
    }
  ]
