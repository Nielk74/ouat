{
  "version": 1,
  "mode": "plan",
  "title": "Move scheduled exports into worker processes",
  "summary": "Run scheduled exports in independent consumers; return a queued job handle.",
  "context": {
    "baseline": "Every five minutes, cron invokes the API, which builds and saves the export before replying.",
    "scope": "Hypothetical proposal; files, snippets, infrastructure, and products are illustrative.",
    "constraints": [
      "Publish durably before accepting; acknowledge after saving.",
      "Bound concurrency and preserve job IDs across deliveries."
    ],
    "assumptions": [
      "The broker supports durable delivery and results have unique job IDs.",
      "The consume wrapper acknowledges after its callback succeeds."
    ],
    "visual": {
      "template": "communication",
      "groups": [
        {
          "id": "api-runtime",
          "label": "API process",
          "kind": "process"
        }
      ],
      "nodes": [
