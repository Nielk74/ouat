      "edges": [
        {
          "from": "cron",
          "to": "request",
          "label": "Invoke the API; wait for its response",
          "transport": "request",
          "status": "unchanged",
          "shortLabel": "Invoke the API;"
        },
        {
          "from": "request",
          "to": "export",
          "label": "Run export inside this API process",
          "status": "unchanged",
          "shortLabel": "Run export inside"
        },
        {
          "from": "export",
          "to": "db",
          "label": "Store the result; only then return done",
          "transport": "write",
          "status": "unchanged",
          "shortLabel": "Store the result;"
        }
      ],
      "scenario": {
        "template": "interrupted-work",
        "from": "request",
        "at": "export",
        "to": "db",
        "condition": "The API process stops mid-export.",
        "cause": "Request and export share a process without a durable handoff.",
        "consequence": "This attempt stores no completed result or successful response; previous results remain and a later retry is possible."
      }
    }
  },
  "changes": [
